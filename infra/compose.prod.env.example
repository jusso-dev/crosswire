# Copy to .env.prod next to docker-compose.prod.yml. Never commit the filled file.
# Start: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# Image to run, for example ghcr.io/jusso-dev/crosswire:sha-<40 hex> or a release tag vX.Y.Z.
# Unset = build crosswire:web from this checkout.
CROSSWIRE_IMAGE=ghcr.io/jusso-dev/crosswire:REPLACE_WITH_TAG
APP_URL=https://crosswire.example.com
# Required: compose refuses to start without it. Any characters work, for example from
# openssl rand -base64 30. It reaches the app as PGPASSWORD, not inside a URL.
POSTGRES_PASSWORD=
# Optional: an external Postgres instead of the bundled one. Use sslmode=verify-full, put the
# password in POSTGRES_PASSWORD (not in the URL), and set DATABASE_TLS_INSECURE_OK=false.
# DATABASE_URL=postgres://crosswire@db.example.com:5432/crosswire?sslmode=verify-full
# The bundled postgres has no TLS and is reachable only on the internal compose network, so the
# start-up warning about sslmode is silenced. This does not change how the app connects.
DATABASE_TLS_INSECURE_OK=true
BETTER_AUTH_SECRET=
APP_ENCRYPTION_KEY=
AUTH_EMAIL_PASSWORD=false
# IP addresses or CIDR ranges of your reverse proxy, for example 172.16.0.0/12.
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_CHAT_PER_MIN=20
# Who may approve and run a KQL search: member, approver or second-person.
KQL_APPROVAL_POLICY=member
APPLICATIONINSIGHTS_CONNECTION_STRING=
ALLOW_DEMO_FIXTURES=false
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
LOG_LEVEL=info
MODEL_PROVIDER=off
HUNTING_DEMO_MODE=false
RESPONSE_DRY_RUN=true
RESPONSE_EXECUTOR_SENTINEL=off
RESPONSE_EXECUTOR_LOGICAPP=off
RESPONSE_EXECUTOR_GRAPH=off
