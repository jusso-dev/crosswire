# Crosswire configuration. Copy to .env (gitignored) and fill in values.
# Every variable the server reads is listed here. Validated at boot by apps/web/src/server/env.ts.
# Production (NODE_ENV=production) refuses to start without APP_URL, DATABASE_URL,
# BETTER_AUTH_SECRET and APP_ENCRYPTION_KEY. Azure: same names as Container App secrets/env
# (Key Vault references), see docs/configuration.md.

# --- Core ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public URL of the app (used for auth callbacks and links in emails). The only value the browser needs.
APP_URL=http://localhost:3000
# Local Compose default. Change the password before exposing Postgres anywhere.
DATABASE_URL=postgres://crosswire:crosswire-local-dev@localhost:5432/crosswire
POSTGRES_PASSWORD=crosswire-local-dev
# debug | info | warn | error. Production logs are JSON lines; secrets are redacted.
LOG_LEVEL=info
# IANA time zone for every time shown in the UI and for the daily digest day. Storage is always UTC.
APP_TIMEZONE=Australia/Sydney

# --- Auth (Better Auth) -------------------------------------------------
# 32+ random characters: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Local email/password sign-in (true for dev). Turn it off in production once Entra SSO works:
# anyone who can reach the app could otherwise create an account (and their own workspace).
AUTH_EMAIL_PASSWORD=true
# Reverse proxy IPs/CIDRs trusted for X-Forwarded-For (comma-separated). Optional.
TRUSTED_PROXIES=
# Session lifetime (docs/auth.md#session-lifetime). Absolute cap since sign-in (1 to 720 hours), and
# idle timeout since the last request (5 to 1440 minutes). MFA is enforced by the IdP, not here.
SESSION_MAX_AGE_HOURS=12
SESSION_IDLE_MINUTES=60

# Entra ID OIDC SSO (optional locally). See docs/auth.md.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Your tenant GUID (recommended, single-tenant) or "organizations" for multi-tenant apps.
ENTRA_TENANT_ID=organizations
# Unknown tenants are rejected by default. true = create a new org on first sign-in from a new tenant.
ENTRA_AUTO_PROVISION_ORGS=false
ENTRA_ORG_NAME=Entra organisation

# SMTP (optional). Without it, digests are in-app only and owners cannot confirm a digest address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Crosswire <crosswire@localhost>

# --- Agents: chat model (ADR 0004; docs/chat-model.md) ---------------------
# off: chat shows a setup message. azure: Azure OpenAI (recommended). openai-compatible: any
# OpenAI-compatible endpoint (OpenAI, a gateway, or a local server for development).
MODEL_PROVIDER=off
# Azure OpenAI: resource endpoint and chat deployment name. Leave the key empty to sign in with
# Entra ID (managed identity in Azure, `az login` locally): needs the Cognitive Services OpenAI User role.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
# openai-compatible
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
AGENT_TIMEOUT_MS=90000

# --- Threat intel -------------------------------------------------------
# Minimum 3600 (1 hour). Live feeds are never fetched more often than this.
TI_CACHE_TTL_SECONDS=3600
TI_HTTP_TIMEOUT_MS=30000
# Largest feed response accepted, in bytes (default 25 MB). Larger responses are refused, not cached.
TI_MAX_RESPONSE_BYTES=26214400
PWN_WATCH_BASE_URL=https://pwn.watch
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# cve.watch is currently unavailable (docs/ti/cve.watch.md). Leave false.
CVE_WATCH_ENABLED=false

# --- Hunting (Defender XDR / Sentinel) ----------------------------------
# 64 hex chars (32 bytes): openssl rand -hex 32. Encrypts connector secrets at rest.
APP_ENCRYPTION_KEY=
# Key rotation only (docs/runbooks/key-rotation.md): the old key(s), comma-separated, 64 hex each.
# Used to decrypt, never to encrypt. Leave empty outside a rotation.
APP_ENCRYPTION_KEY_PREVIOUS=
# true: orgs without a connector get labelled fixture data, never live tenant data.
HUNTING_DEMO_MODE=true
HUNTING_MAX_ROWS=100
HUNTING_TIMEOUT_MS=60000
KQL_PROPOSAL_TTL_HOURS=24
# Who may approve and run a KQL search (docs/hunting.md): member (any org member) | approver (owners
# and approvers) | second-person (an approver other than the requester; no edits at approval).
KQL_APPROVAL_POLICY=member

# --- Gated response -----------------------------------------------------
# Global dry-run guard (#83). Unset or true = no executor can make a live call (fail closed).
# Live execution needs BOTH RESPONSE_DRY_RUN=false AND RESPONSE_EXECUTOR_<X>=on, via a change ticket.
RESPONSE_DRY_RUN=true
# off | dry-run | on. Keep off until you have reviewed docs/response.md.
RESPONSE_EXECUTOR_SENTINEL=off
RESPONSE_EXECUTOR_LOGICAPP=off
RESPONSE_EXECUTOR_GRAPH=off
# Logic App HTTP trigger URL (contains a SAS signature: treat as a secret).
RESPONSE_LOGICAPP_URL=
# Allow an approver to approve their own proposal. Off by default; tiny labs only.
RESPONSE_ALLOW_SELF_APPROVAL=false
RESPONSE_PROPOSAL_TTL_HOURS=24
# v2: most devices/incidents one live proposal may act on (hard ceiling 50).
RESPONSE_MAX_LIVE_TARGETS=10

# v2 kill switches. Scheduled hunts still need an approver per schedule; channels are per org.
SCHEDULED_HUNTS_ENABLED=true
NOTIFICATIONS_ENABLED=true

# --- HTTP hardening (#74) -------------------------------------------------
# Extra allowed origins (comma-separated) for CORS and Better Auth trusted origins. APP_URL is always
# allowed; "*" is ignored.
CORS_ALLOWED_ORIGINS=
# Per-client requests per minute to /api/chat.
RATE_LIMIT_CHAT_PER_MIN=20
# database: chat and sign-in limits are shared by every replica (Postgres tables). memory: per process
# (each replica counts on its own). Keep database unless you run exactly one replica.
RATE_LIMIT_STORAGE=database

# --- Data retention (docs/runbooks/data-retention.md) ---------------------
# Days to keep each kind of data; the worker purges daily at 00:30 in APP_TIMEZONE. 0 keeps forever.
RETENTION_CHAT_DAYS=365
RETENTION_DECISIONS_DAYS=365
# Stored result sample rows are removed after this; row counts and columns are kept.
RETENTION_SAMPLES_DAYS=180
RETENTION_AUDIT_DAYS=730

# --- Squad SDK governance ---------------------------------------------------
# enforced: quarantine untrusted memory, durable runs, egress filter, approval payload hash.
# legacy: previous behaviour for that one control. Token and inflight budgets always apply.
MEMORY_GOVERNANCE=enforced
RUN_LEDGER=enforced
EGRESS_FILTER=enforced
APPROVAL_BINDING=enforced
BUDGET_MAX_INPUT_TOKENS=24000
BUDGET_MAX_OUTPUT_TOKENS=4000
BUDGET_MAX_INFLIGHT=8
BUDGET_CONTEXT_WINDOW_TOKENS=128000
BUDGET_DAILY_INPUT_TOKENS=200000
# Dollar price is optional. Leave the rate unset and usage is unpriced: the cost column is null, never 0.
# A spend cap without a rate refuses model calls. A spend cap also refuses when today already has an unpriced row.
# A finished model call with no token count is stored as null and blocks the daily cap until the next UTC day.
# Explicit provider zeroes are a real count. They are not stored as unpriced.
# BUDGET_MAX_SPEND_MICROS=
# BUDGET_USD_PER_MILLION_TOKENS=

# --- Observability (#73) ----------------------------------------------------
# Application Insights connection string (set by Bicep in Azure). Empty = disabled.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Demo data (#77) --------------------------------------------------------
# Demo fixtures are refused in production unless this is true (labs only).
ALLOW_DEMO_FIXTURES=false

# --- Later (not v1; optional) -------------------------------------------
# SAML SSO via Better Auth's SSO plugin (docs/auth.md#saml-sso-later). Entra OIDC stays the default.
SAML_ENABLED=false
# Cloudflare Radar enrichment for IP/domain compare (docs/watchlists.md). Token needs Radar read only.
RADAR_ENABLED=false
CLOUDFLARE_API_TOKEN=
