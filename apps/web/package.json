{
  "name": "web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && node scripts/build-env-check.mjs",
    "start": "node server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/server/cli/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/server/cli/seed.ts",
    "ingest:pwn": "tsx --env-file-if-exists=../../.env src/server/cli/ingest-pwn.ts",
    "ingest:cve": "tsx --env-file-if-exists=../../.env src/server/cli/ingest-cve.ts",
    "match:watches": "tsx --env-file-if-exists=../../.env src/server/cli/match.ts",
    "digest:daily": "tsx --env-file-if-exists=../../.env src/server/cli/digest.ts",
    "expire:proposals": "tsx --env-file-if-exists=../../.env src/server/cli/expire.ts",
    "compact-memory": "tsx --env-file-if-exists=../../.env src/server/cli/compact.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/server/cli/worker.ts"
  },
  "dependencies": {
    "@better-auth/sso": "1.7.18",
    "@tanstack/ai": "1.2.0",
    "@tanstack/ai-anthropic": "1.1.1",
    "@tanstack/ai-client": "1.1.0",
    "@tanstack/ai-openai": "1.1.1",
    "@tanstack/ai-react": "1.0.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "nodemailer": "8.0.11",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "srvx": "1.0.8",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
