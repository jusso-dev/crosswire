    "ingest:pwn": "pnpm --filter web ingest:pwn",
    "ingest:cve": "pnpm --filter web ingest:cve",
    "match:watches": "pnpm --filter web match:watches",
    "digest:daily": "pnpm --filter web digest:daily",
    "expire:proposals": "pnpm --filter web expire:proposals",
    "compact-memory": "pnpm --filter web compact-memory",
